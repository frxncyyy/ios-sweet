+	if (!frequency) { return false; }
+	uint64_t start = nord2_ufs_counter();
+	for (unsigned i = 0; i < N2_UIC_POLL_LIMIT; i++) {
+		if ((ufs_rd(off) & mask) == want) { return true; }
