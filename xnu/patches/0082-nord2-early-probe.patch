+static const uint16_t attrs[SNAP]={0x1583,0x1580,0x1584,0x1568,0x1560,0x1569,
+ 0x156a,0x1571,0x15d4,0x15b0,0x15b1,0x15b2,0x15b3,0x15b4,0x15b5,0xd041,0xd042,0xd043};
