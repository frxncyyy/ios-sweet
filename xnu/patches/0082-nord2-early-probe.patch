+static bool
+nord2_ufs_wait(uint32_t off, uint32_t mask, uint32_t value)
+{
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	while ((ufs_rd(off) & mask) != value) {
+		if (mach_absolute_time() >= deadline) {
+			return false;
+		}
+		delay(10);
+	}
+	return true;
+}
