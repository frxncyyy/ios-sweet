+  delay_us=10;
+ }
+ if((s->clock&6)!=6){s->error=-102;goto fail;}
+ TRY(read(&x,0x180602d4,&s->irq));
+ if(!(s->irq&1)){s->error=-103;goto fail;}
+ TRY(read(&x,0x18060184,&v));if(v&0x20){s->error=-104;goto fail;}
