+static uint32_t
+nusb_phy_rd(uint32_t offset)
+{
+	return nord2_usb_read(nusb_phy.com, offset);
+}
+
+static void
+nusb_phy_wr(uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(nusb_phy.com + offset) = value;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
