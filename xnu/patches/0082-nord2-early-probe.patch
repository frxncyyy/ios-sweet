+ while(range(off,4,end)){
+  uint32_t token=be32(f+off);off+=4;
+  if(token==1){
+   while(off<end&&f[off])off++;
+   if(off==end||depth>=32)return -1;
+   off=(off+4)&~(size_t)3;depth++;
+  }else if(token==2){if(!depth)return -1;depth--;}
+  else if(token==3){
