+ v=rd(s,0x34);if(!gate(s,1,v,(v&1)!=0))return 0;
+ v=rd(s,HCS);if(!gate(s,2,v,(v&0xb)==0xb))return 0;
+ v=rd(s,HCS);if(!gate(s,3,v,(v&0x30)==0))return 0;
