+static uint8_t
+ni_crc(uint8_t addr, uint8_t reg, uint8_t value)
+{
+	uint8_t bytes[3] = {addr, reg, value}, crc = 0;
+	for (unsigned n = 0; n < 3; n++) {
+		crc ^= bytes[n];
+		for (unsigned b = 0; b < 8; b++) {
+			crc = (uint8_t)((crc << 1) ^ ((crc & 0x80) ? 7 : 0));
+		}
+	}
+	return crc;
+}
