+	if (!nord2_ufs_uic_poll(REG_IS, N2_UIC_COMPLETE, N2_UIC_COMPLETE) ||
+	    !nord2_ufs_uic_poll(REG_HCS, N2_UIC_READY, N2_UIC_READY)) {
+		return false;
