+ s->stage=NPP_WF_ACK;
+ if(poll(o,c,s,ACK,1u<<5,0,12,1000,&s->wf_polls,&v))return s->error;
+ if(check(o,c,s)||o->readable(c))return fail(s,-10);
+ s->stage=NPP_LIVE;
+ if(version(o,c,s,CFG,0x20010101u,12,1000,&s->cfg_polls,&s->cfg_id))return s->error;
