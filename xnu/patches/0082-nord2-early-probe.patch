 void
 sweet_early_disable(void)
 {
+#if defined(NORD2)
+	/* Nothing to tear down: the pmsg ring stays valid in the kernel map. */
+	nord2_flush();
+#else
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+
+#if defined(NORD2)
+/*
+ * Leave XNU and resume the stock Android kernel that the loader preserved at
+ * a 2 MiB offset. Everything is validated by the loader, which writes the
+ * entry and device-tree physical addresses into /chosen.
+ */
+extern uint8_t bootstrap_pagetables[];
+extern void nord2_leave_xnu(uint64_t entry_pa, uint64_t dtb_pa,
+    uint64_t cache_start, uint64_t cache_end, uint64_t tramp_pa)
+    __attribute__((noreturn));
+
+void
+nord2_leave_to(uint64_t entry_override)
+{
+	DTEntry chosen = NULL;
+	void const *prop;
+	unsigned int size;
+	uint64_t entry = 0, dtb = 0;
+	uint64_t region_start = 0, region_end = 0;
+
+	/* Mask everything now: a context switch would reload TTBR0 below. */
+	__builtin_arm_wsr("DAIFSet", 0xf);
+	__builtin_arm_isb(ISB_SY);
+
+	/* Any non-boot caller requests CPU0 to return, then powers itself off.
+	 * CPU0 must observe every secondary OFF before USB/UFS or memory reuse. */
+	if (nord2_kernel_smp_prepare_return() < 0) {
+		sweet_early_string("NORD2 SMP: XNU secondary still active; manual reboot required\n");
+		nord2_flush();
+		for (;;) {
+			__asm__ volatile("wfe");
+		}
+	}
+	nord2_leaving = 1;
+
+	/* A PSCI probe core must be OFF before Linux can reuse XNU memory. */
+	if (nord2_smp_prepare_return() < 0) {
+		sweet_early_string("NORD2 SMP: secondary still active; manual reboot required\n");
+		nord2_flush();
+		for (;;) {
+			__asm__ volatile("wfe");
+		}
+	}
+
+	/*
+	 * A later filesystem/userspace panic can arrive while the UFS root
+	 * driver still owns the inherited controller. Do not hand its active
+	 * DMA list to the next kernel. This is a no-op before UFS initialization.
+	 */
+	if (nord2_input_prepare_return() < 0) {
+		sweet_early_string("NORD2 INPUT: PMIF/VTP cleanup failed; manual reboot required\n");
+		nord2_flush();
+		for (;;) { __asm__ volatile("wfe"); }
+	}
+	nord2_display_overlay_restore();
+	int usb_restored = nord2_usb_prepare_return();
+	if (usb_restored < 0) {
+		sweet_early_string("NORD2 USB: unsafe owner at kernel return; manual reboot required\n");
+		nord2_flush();
+		for (;;) {
+			__asm__ volatile("wfe");
+		}
+	}
+	if (usb_restored > 0) {
+		sweet_early_string("NORD2 USB: controller restored before kernel return\n");
+	}
+	int ufs_restored = nord2_ufs_prepare_return();
+	if (ufs_restored < 0) {
+		sweet_early_string("NORD2 UFS: unsafe DMA at kernel return; manual reboot required\n");
+		nord2_flush();
+		for (;;) {
+			__asm__ volatile("wfe");
+		}
+	}
+	if (ufs_restored > 0) {
+		sweet_early_string("NORD2 UFS: root host restored before kernel return\n");
+	}
+
+	/*
+	 * Prefer the parameters cached at the cpu_init stop: once arm_vm_init()
+	 * has switched tables, a device-tree lookup can itself fault.
+	 */
+	if (nord2_cb_valid) {
+		entry = nord2_cb_entry;
+		dtb = nord2_cb_dtb;
+		region_start = nord2_cb_start;
+		region_end = nord2_cb_end;
+	} else if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess) {
+		if (SecureDTGetProperty(chosen, "nord2-stock-entry", &prop, &size) == kSuccess &&
+		    size == sizeof(uint64_t)) {
+			entry = *(uint64_t const *)prop;
+		}
+		if (SecureDTGetProperty(chosen, "nord2-stock-dtb", &prop, &size) == kSuccess &&
+		    size == sizeof(uint64_t)) {
+			dtb = *(uint64_t const *)prop;
+		}
+		if (SecureDTGetProperty(chosen, "nord2-xnu-region", &prop, &size) == kSuccess &&
+		    size == 2 * sizeof(uint64_t)) {
+			region_start = ((uint64_t const *)prop)[0];
+			region_end = ((uint64_t const *)prop)[1];
+		}
+	} else {
+		sweet_early_string("NORD2-XNU: no /chosen\n");
+	}
+	if ((entry == 0 || dtb == 0 || region_start == 0 ||
+	    region_end <= region_start) && nord2_cb_valid) {
+		/*
+		 * arm_vm_init() switched the kernel page tables, so the ADT (placed
+		 * just past the kernel image) is no longer reachable: fall back to
+		 * the copy taken while it still was.
+		 */
+		sweet_early_string("NORD2-XNU: using cached chain-back parameters\n");
+		entry = nord2_cb_entry;
+		dtb = nord2_cb_dtb;
+		region_start = nord2_cb_start;
+		region_end = nord2_cb_end;
+	}
+	if (entry_override != 0) {
+		entry = entry_override;
+	}
+	if (entry == 0 || dtb == 0 || region_start == 0 || region_end <= region_start) {
+		sweet_early_string("NORD2-XNU: cannot chain back\n");
+		for (;;) {
+			__asm__ volatile("wfe");
+		}
+	}
+	sweet_early_string("NORD2-XNU: RETURN TO STOCK ANDROID KERNEL\n");
+	sweet_early_string("NORD2-XNU: entry=");
+	/* Minimal hex, no formatting dependency at this point. */
+	nord2_hex64(entry);
+	sweet_early_string("\n");
+	/*
+	 * The trampoline and its cache-clean loop run through the bootstrap V=P
+	 * map. After the first context switch TTBR0 holds invalid_ttep, so put
+	 * the bootstrap table back. It stays intact for the whole boot: it is
+	 * read-only-late data and cpu.c uses it to start secondary CPUs.
+	 */
+	set_mmu_ttb(kvtophys((vm_offset_t)bootstrap_pagetables) & TTBR_BADDR_MASK);
+	flush_mmu_tlb();
+	/* The trampoline lives 16K above the first mapped block. */
+	nord2_leave_xnu(entry, dtb, region_start, region_end,
+	    region_start + 0x4000);
+}
+
+void
+nord2_return_to_stock(void)
+{
+	nord2_leave_to(0);
+}
+
+/*
+ * Boot-arg nord2stop: 1 (default) stops after cpu_init and returns to the
+ * stock kernel; 0 continues into arm_vm_init (not yet supported on Nord2).
+ */
+/*
+ * Optional later stop points (boot argument nord2stopat=<n>): log a marker and
+ * return to Android with the pmsg log intact. Unlike the arm_vm_init gates
+ * these run with the kernel page tables fully switched, which is fine because
+ * the chain-back parameters were cached at the cpu_init stop.
+ */
+/* kernel_bootstrap_log() / kernel_bootstrap_thread_log() steps (startup.c). */
+void
+nord2_bootstrap_log(const char *who, const char *message)
+{
+	sweet_early_string(who);
+	sweet_early_string(message);
+	sweet_early_string("\n");
+}
+
+/*
+ * Called from sleh_irq() for every acknowledged interrupt: proves the timer
+ * PPI is delivered once the scheduler runs (first 3 ticks, then every 256th
+ * up to the 2048th)
+ * and names the first few other INTIDs.
+ */
+extern uint32_t sweet_vtimer_intid;	/* pexpert/arm/pe_fiq.c */
+static uint64_t nord2_ticks;
+static unsigned int nord2_other_irqs;
+
+void
+nord2_irq_seen(uint32_t intid, uint64_t pc)
+{
+	if (nord2_wdt) {
+		nord2_wdt[2] = 0x1971;	/* WDT_RST: keep the SoC alive */
+	}
+	if (nord2_kernel_smp_active) {
+		unsigned core = nord2_raw_core();
+		if (core < 8) {
+			if (intid == sweet_vtimer_intid) {
+				__atomic_fetch_add(&nord2_cpu_ticks[core], 1, __ATOMIC_RELAXED);
+			} else if (intid < 16) {
+				__atomic_fetch_add(&nord2_cpu_ipis[core], 1, __ATOMIC_RELAXED);
+			}
+		}
+		return; /* Per-core counts replace the single-CPU verbose diagnostics. */
+	}
+	if (intid == sweet_vtimer_intid) {
+		nord2_ticks++;
+		/* Bounded, so a live timer cannot scroll the real last line away. */
+		if ((nord2_ticks & 0x3f) == 0 && nord2_wdt && nord2_ticks <= 256) {
+			nord2_wdt_log("wdt_mode", nord2_wdt[0]);
+			nord2_wdt_log("wdt_length", nord2_wdt[1]);
+			nord2_wdt_log("wdt_status", nord2_wdt[3]);
+		}
+		if (nord2_ticks <= 3 || ((nord2_ticks & 0x3f) == 0 && nord2_ticks <= 2048)) {
+			sweet_early_string("NORD2-XNU: timer tick 0x");
+			nord2_hex64(nord2_ticks);
+			sweet_early_string(" pc=0x");
+			nord2_hex64(pc);
+			sweet_early_string("\n");
+		}
+	} else if (nord2_other_irqs < 8) {
+		nord2_other_irqs++;
+		sweet_early_string("NORD2-XNU: irq intid 0x");
+		nord2_hex64(intid);
+		sweet_early_string("\n");
+	}
+}
+
+void
+nord2_stop_at(unsigned int point, const char *label)
+{
+	uint32_t want = 0;
+
+	(void)PE_parse_boot_argn("nord2stopat", &want, sizeof(want));
+	if (want == 0 || want != point) {
+		return;
+	}
+	sweet_early_string("NORD2-XNU: stop at ");
+	sweet_early_string(label);
+	sweet_early_string("\n");
+	nord2_leave_to(0);
+}
+
+/* NORD2 PSCI PROBE: no secondary enters XNU, no stack or disk access. */
+extern void nord2_psci_probe_entry(void);
+extern void nord2_psci_low_probe_entry(void);
+extern void nord2_psci_probe_end(void);
+static bool nord2_psci_probe_active;
+static volatile uint8_t *nord2_psci_low_alias;
+#define NORD2_PSCI_LOW_CODE 0x40180000UL
+#define NORD2_PSCI_LOW_BOX  0x40184000UL
+#define NORD2_PSCI_LOW_SIZE 0x8000UL
+
+static int32_t
+nord2_psci_call(uint64_t fn, uint64_t arg1, uint64_t arg2, uint64_t arg3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = arg1;
+	register uint64_t x2 __asm__("x2") = arg2;
+	register uint64_t x3 __asm__("x3") = arg3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+static uint64_t
+nord2_psci_now(void)
+{
+	return __builtin_arm_rsr64("CNTVCT_EL0");
+}
+
+static void
+nord2_psci_poll(void)
+{
+	if (nord2_wdt) {
+		nord2_wdt[2] = 0x1971;
+	}
+	__asm__ volatile("yield" ::: "memory");
+}
+
+static bool
+nord2_psci_all_off(void)
+{
+	for (unsigned core = 1; core < 8; core++) {
+		/* PSCI AFFINITY_INFO64, lowest_affinity_level=0; OFF is 1. */
+		if (nord2_psci_call(0xc4000004, core << 8, 0, 0) != 1) {
+			return false;
+		}
+	}
+	return true;
+}
+
+int
+nord2_smp_prepare_return(void)
+{
+	if (!nord2_psci_probe_active) {
+		return 0;
+	}
+	uint64_t deadline = nord2_psci_now() +
+	    __builtin_arm_rsr64("CNTFRQ_EL0") * 5;
+	do {
+		if (nord2_psci_all_off()) {
+			/* Restore the zero padding only after every secondary is OFF. */
+			if (nord2_psci_low_alias) {
+				for (unsigned i = 0; i < NORD2_PSCI_LOW_SIZE; i++) {
+					nord2_psci_low_alias[i] = 0;
+				}
+				__builtin_arm_dsb(DSB_SY);
+				nord2_psci_low_alias = NULL;
+			}
+			nord2_psci_probe_active = false;
+			return 1;
+		}
+		nord2_psci_poll();
+	} while (nord2_psci_now() < deadline);
+	return -1; /* Do not release memory or chain back with a running core. */
+}
+
+/* 128-byte slots; offsets 0..72 match the stackless physical entry in start.s. */
+struct nord2_psci_mailbox {
+	uint64_t magic, el, mpidr, midr, sctlr, frequency, ticks, context;
+	uint64_t off_result, state;
+	uint64_t padding[6];
+};
+_Static_assert(sizeof(struct nord2_psci_mailbox) == 128, "PSCI mailbox layout");
+
+static bool
+nord2_psci_wait_off(volatile struct nord2_psci_mailbox *box,
+    unsigned core, uint64_t deadline)
+{
+	do {
+		int32_t affinity = nord2_psci_call(0xc4000004, core << 8, 0, 0);
+		__asm__ volatile("dmb oshld" ::: "memory");
+		if (affinity == 1 && box->state == 1) {
+			return true;
+		}
+		if (affinity < 0 || box->state == 2) {
+			return false;
+		}
+		nord2_psci_poll();
+	} while (nord2_psci_now() < deadline);
+	return false;
+}
+
+static bool
+nord2_psci_result_valid(volatile struct nord2_psci_mailbox *box,
+    unsigned core, uint64_t context, unsigned mode, uint64_t frequency, bool off)
+{
+	/* Point18 proved that this firmware delivered x0=0. Point19 derives
+	 * its slot from MPIDR and never dereferences x0; keep it diagnostic.
+	 * Retain strict context checking for the original point17/18 probes. */
+	return off && box->state == 1 && box->off_result == 0 &&
+	       box->magic == 0x4e32534d &&
+	       (mode == 19 || box->context == context) &&
+	       (box->mpidr & 0xff00ffffffULL) == (core << 8) &&
+	       ((box->midr >> 4) & 0xfff) == (core < 4 ? 0xd05 : 0xd41) &&
+	       (box->el == 4 || box->el == 8) && !(box->sctlr & 5) &&
+	       box->frequency == frequency;
+}
+
+void
+nord2_smp_probe(void)
+{
+	unsigned stop = 0, cpus = 0;
+	PE_parse_boot_argn("nord2stopat", &stop, sizeof(stop));
+	if (stop == 20 || stop == 21 || stop == 22 || stop == 23) {
+		nord2_kernel_smp_probe();
+		return;
+	}
+	if (stop != 17 && stop != 18 && stop != 19) {
+		return;
+	}
+	PE_parse_boot_argn("cpus", &cpus, sizeof(cpus));
+	if (cpus != 1 || (__builtin_arm_rsr64("MPIDR_EL1") & 0xffff) != 0) {
+		printf("NORD2 SMP: firmware probe requires one XNU CPU, MPIDR0\n");
+		goto done;
+	}
+	printf("NORD2 SMP: PSCI probe begin; seven secondaries, sequential CPU_ON/OFF\n");
+	int32_t version = nord2_psci_call(0x84000000, 0, 0, 0);
+	printf("NORD2 SMP: PSCI version=%08x boot MIDR=%llx\n",
+	    version, __builtin_arm_rsr64("MIDR_EL1"));
+	/* The live DT advertises PSCI1.0. Refuse unknown feature behavior. */
+	if (version < 0x10000 ||
+	    nord2_psci_call(0x8400000a, 0xc4000003, 0, 0) < 0 ||
+	    nord2_psci_call(0x8400000a, 0x84000002, 0, 0) < 0 ||
+	    nord2_psci_call(0x8400000a, 0xc4000004, 0, 0) < 0 ||
+	    nord2_psci_call(0xc4000004, 0, 0, 0) != 0) {
+		printf("NORD2 SMP: required PSCI features unavailable\n");
+		goto done;
+	}
+	if (!nord2_psci_all_off()) {
+		printf("NORD2 SMP: inherited secondary is not OFF; refused\n");
+		/* Even an inherited active core makes a chain-back unsafe. */
+		nord2_psci_probe_active = true;
+		goto done;
+	}
+	uint64_t pa, entry;
+	volatile struct nord2_psci_mailbox *boxes;
+	if (stop == 18 || stop == 19) {
+		/* Reserved loader prefix: code/BSS/stack end below40180000, original
+		 * Linux starts40280000. Checker also requires this entire hole zero. */
+		size_t stub_size = (uintptr_t)nord2_psci_probe_end -
+		    (uintptr_t)nord2_psci_low_probe_entry;
+		volatile uint8_t *alias = (volatile uint8_t *)ml_io_map(
+		    NORD2_PSCI_LOW_CODE, NORD2_PSCI_LOW_SIZE);
+		if (!alias || !stub_size || stub_size > 0x4000) {
+			printf("NORD2 SMP: low trampoline mapping/size refused\n");
+			goto done;
+		}
+		for (unsigned i = 0; i < NORD2_PSCI_LOW_SIZE; i++) {
+			if (alias[i]) {
+				printf("NORD2 SMP: loader scratch is not zero; refused\n");
+				goto done;
+			}
+		}
+		nord2_psci_low_alias = alias;
+		nord2_psci_probe_active = true;
+		const uint8_t *stub = (const uint8_t *)nord2_psci_low_probe_entry;
+		for (size_t i = 0; i < stub_size; i++) {
+			alias[i] = stub[i];
+		}
+		__asm__ volatile("dsb sy; ic ialluis; dsb sy; isb" ::: "memory");
+		for (size_t i = 0; i < stub_size; i++) {
+			if (alias[i] != stub[i]) {
+				printf("NORD2 SMP: low trampoline readback mismatch\n");
+				goto done;
+			}
+		}
+		pa = NORD2_PSCI_LOW_BOX;
+		entry = NORD2_PSCI_LOW_CODE;
+		boxes = (volatile struct nord2_psci_mailbox *)(alias + 0x4000);
+		printf("NORD2 SMP: low32 trampoline copied and verified; fixed mailbox\n");
+	} else {
+		vm_offset_t memory = 0;
+		if (kmem_alloc_contig(kernel_map, &memory, PAGE_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("NORD2 SMP: mailbox allocation failed\n");
+			goto done;
+		}
+		pa = ptoa_64(pmap_find_phys(kernel_pmap, memory));
+		entry = ml_static_vtop((vm_offset_t)nord2_psci_probe_entry);
+		if (!pa || !entry) {
+			printf("NORD2 SMP: physical translation failed\n");
+			goto done;
+		}
+		/* Clean the cached zeroed allocation, then use only the uncached alias. */
+		CleanPoC_DcacheRegion_Force(memory, PAGE_SIZE);
+		CleanPoC_DcacheRegion_Force((vm_offset_t)nord2_psci_probe_entry,
+		    (uintptr_t)nord2_psci_probe_end - (uintptr_t)nord2_psci_probe_entry);
+		boxes = (volatile struct nord2_psci_mailbox *)ml_io_map(pa, PAGE_SIZE);
+		if (!boxes) {
+			printf("NORD2 SMP: mailbox mapping failed\n");
+			goto done;
+		}
+	}
+	printf("NORD2 SMP: entry_pa=%llx mailbox_pa=%llx mode=%u\n", entry, pa, stop);
+	__builtin_arm_dsb(DSB_SY);
+	nord2_psci_probe_active = true; /* Also protects every panic return. */
+	if (stop == 19) {
+		printf("NORD2 SMP: fixed mailbox ignores context_id; low then high entry\n");
+	}
+	for (unsigned pass = 0; pass < (stop == 19 ? 2U : 1U); pass++) {
+		if (pass) {
+			/* Test the same fixed-mailbox stub at its linked high PA.
+			 * This separates entry address support from lost context_id.
+			 * Never recycle mailboxes while any secondary remains live. */
+			if (!nord2_psci_all_off()) {
+				printf("NORD2 SMP: high-entry pass refused; secondary not OFF\n");
+				break;
+			}
+			entry = ml_static_vtop((vm_offset_t)nord2_psci_low_probe_entry);
+			if (entry <= 0xffffffffULL) {
+				printf("NORD2 SMP: high entry translation refused\n");
+				break;
+			}
+			CleanPoC_DcacheRegion_Force((vm_offset_t)nord2_psci_low_probe_entry,
+			    (uintptr_t)nord2_psci_probe_end - (uintptr_t)nord2_psci_low_probe_entry);
+			volatile uint8_t *bytes = (volatile uint8_t *)boxes;
+			for (unsigned i = 0; i < 8 * sizeof(*boxes); i++) {
+				bytes[i] = 0;
+			}
+			__asm__ volatile("dsb sy; ic ialluis; dsb sy; isb" ::: "memory");
+		}
+		printf("NORD2 SMP: pass=%u entry_pa=%llx mailbox_pa=%llx\n", pass, entry, pa);
+		unsigned passed = 0;
+		for (unsigned core = 1; core < 8; core++) {
+			uint64_t context = pa + core * sizeof(*boxes);
+			volatile struct nord2_psci_mailbox *box = &boxes[core];
+			int32_t rc = nord2_psci_call(0xc4000003, core << 8, entry, context);
+			printf("NORD2 SMP: CPU_ON core=%u target=%03x rc=%d\n", core, core << 8, rc);
+			if (rc != 0) {
+				break;
+			}
+			bool off = nord2_psci_wait_off(box, core, nord2_psci_now() +
+			    __builtin_arm_rsr64("CNTFRQ_EL0") * 5);
+			printf("NORD2 SMP: core=%u state=%llu EL=%llu MPIDR=%llx MIDR=%llx "
+			    "SCTLR=%llx CNTFRQ=%llu OFF=%u off_rc=%lld\n",
+			    core, box->state, box->el >> 2, box->mpidr, box->midr,
+			    box->sctlr, box->frequency, off, (int64_t)box->off_result);
+			printf("NORD2 SMP: core=%u magic=%llx context=%llx expected=%llx affinity=%d\n",
+			    core, box->magic, box->context, context,
+			    nord2_psci_call(0xc4000004, core << 8, 0, 0));
+			if (!nord2_psci_result_valid(box, core, context, stop,
+			    __builtin_arm_rsr64("CNTFRQ_EL0"), off)) {
+				printf("NORD2 SMP: core=%u result mismatch; stopped\n", core);
+				break;
+			}
+			passed++;
+		}
+		printf("NORD2 SMP: pass=%u firmware probe %u/7 secondaries passed; "
+		    "XNU scheduler still single CPU\n", pass, passed);
+		if (passed != 7) {
+			break;
+		}
+	}
+	if (nord2_smp_prepare_return() == 1) {
+		printf("NORD2 SMP: all secondary affinities OFF; return permitted\n");
+	}
+ done:
+	nord2_stop_at(stop, stop == 19 ? "after fixed-mailbox PSCI low/high probe" :
+	    stop == 18 ? "after low32 PSCI CPU_ON/OFF probe" :
+	    "after bounded PSCI CPU_ON/OFF probe");
+}
+/* END NORD2 PSCI PROBE */
+
+/* NORD2 XNU SMP: bounded scheduler test and coordinated final shutdown.
+ * No CPU hotplug/resume is implemented; CPU_OFF is only for leaving XNU. */
+static uint32_t nord2_smp_stop_requested;
+static int32_t nord2_smp_off_error[8];
+static uint32_t nord2_smp_userland_passed;
+
+/* The PE numeric parser selects a value but cannot prove uniqueness or exact
+ * spelling. The stop-only RO exception requires bounded, unique key=value
+ * tokens from the original command line, matching the image checker's bundle.
+ * Ordinary configurations retain their existing PE-parser behavior. */
+static bool
+nord2_smp_arg_exact(const char *key, const char *expected, unsigned *occurrences)
+{
+	/* PE_boot_args() already returns CommandLine, not the boot_args struct. */
+	const char *cmd = PE_boot_args();
+	const size_t capacity = sizeof(((struct boot_args *)0)->CommandLine);
+	*occurrences = 0;
+	if (!cmd) { *occurrences = 1; return false; }
+	size_t length = 0, key_length = 0;
+	while (length < capacity && cmd[length]) { length++; }
+	if (length == capacity) { *occurrences = 1; return false; }
+	while (key[key_length]) { key_length++; }
+	bool matched = false;
+	for (size_t pos = 0; pos < length;) {
+		/* ASCII whitespace, as used by the offline image argument split. */
+		if (cmd[pos] == ' ' || (cmd[pos] >= '\t' && cmd[pos] <= '\r')) { pos++; continue; }
+		size_t begin = pos;
+		while (pos < length && cmd[pos] != ' ' && !(cmd[pos] >= '\t' && cmd[pos] <= '\r')) { pos++; }
+		size_t end = pos, n = 0;
+		while (n < key_length && begin + n < end && cmd[begin + n] == key[n]) { n++; }
+		if (n != key_length || (begin + n != end && cmd[begin + n] != '=')) { continue; }
+		(*occurrences)++;
+		if (begin + n == end) { continue; } /* bare flag is never explicit */
+		size_t value = begin + n + 1;
+		n = 0;
+		while (value + n < end && expected[n] && cmd[value + n] == expected[n]) { n++; }
+		if (value + n == end && !expected[n]) { matched = true; }
+	}
+	return *occurrences == 1 && matched;
+}
+
+static bool
+nord2_smp_lane_diag_config(void)
+{
+	static const char *const required[][2] = {
+		{ "nord2stopat", "23" }, { "cpus", "8" },
+		{ "rd", "ufsroot0" }, { "ufsroot", "userdata" },
+		{ "nord2ufs2lane", "1" }, { "ufsrw", "0" }, { "rootrw", "0" },
+		{ "nord2input", "0" }, { "nord2wifi", "0" }, { "nord2wififw", "0" },
+		{ "nord2wifiemi", "0" }, { "nord2fbdiag", "0" }, { "nord2ufsprofile", "1" }
+	};
+	for (unsigned i = 0; i < sizeof(required) / sizeof(required[0]); i++) {
+		unsigned count;
+		if (!nord2_smp_arg_exact(required[i][0], required[i][1], &count)) { return false; }
+	}
+	return true;
+}
+
+static bool
+nord2_smp_userland_config(unsigned stop)
+{
+	unsigned lane_count;
+	(void)nord2_smp_arg_exact("nord2ufs2lane", "1", &lane_count);
+	if (lane_count) {
+		return stop == 23 && nord2_smp_lane_diag_config();
+	}
+	char root[16] = {0};
+	int ufsrw = -1, rootrw = -1;
+	PE_parse_boot_argn("rd", root, sizeof(root));
+	root[sizeof(root) - 1] = 0;
+	PE_parse_boot_argn("ufsrw", &ufsrw, sizeof(ufsrw));
+	PE_parse_boot_argn("rootrw", &rootrw, sizeof(rootrw));
+	int expected_rw = stop == 23 ? 1 : 0;
+	if (ufsrw != expected_rw || rootrw != expected_rw) {
+		return false;
+	}
+	if (stop == 21) {
+		return !strcmp(root, "md0");
+	}
+	if (stop == 22 || stop == 23) {
+		char part[16] = {0};
+		PE_parse_boot_argn("ufsroot", part, sizeof(part));
+		part[sizeof(part) - 1] = 0;
+		return !strcmp(root, "ufsroot0") && !strcmp(part, "userdata");
+	}
+	return false;
+}
+
+int
+nord2_smp_userland_ready(void)
+{
+	return nord2_kernel_smp_active &&
+	       __atomic_load_n(&nord2_smp_userland_passed, __ATOMIC_ACQUIRE) &&
+	       !__atomic_load_n(&nord2_smp_stop_requested, __ATOMIC_ACQUIRE);
+}
+
+static void
+nord2_smp_send_stop(unsigned core)
+{
+	/* Nord2 MPIDR Aff1=core, Aff0=0; the existing driver enables SGI1. */
+	__builtin_arm_dsb(DSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1",
+	    (1ULL << 24) | ((uint64_t)core << 16) | 1);
+	__builtin_arm_isb(ISB_SY);
+}
+
+static void __attribute__((noreturn))
+nord2_smp_off_self(void)
+{
+	unsigned core = nord2_raw_core();
+	__builtin_arm_wsr("DAIFSet", 0xf);
+	__builtin_arm_wsr64("CNTV_CTL_EL0", 0);
+	__builtin_arm_isb(ISB_SY);
+	/* A panic inside console output must not leave its lock owned forever. */
+	if (__atomic_load_n(&nord2_console_owner, __ATOMIC_RELAXED) == core + 1) {
+		__atomic_store_n(&nord2_console_owner, 0, __ATOMIC_RELEASE);
+	}
+	/* Like the existing XNU shutdown path, clean before firmware power-off.
+	 * PSCI handles the final coherent-domain exit; MMU stays on for the call. */
+	CleanPoC_Dcache();
+	__builtin_arm_dsb(DSB_SY);
+	int32_t rc = nord2_psci_call(0x84000002, 0, 0, 0);
+	if (core < 8) {
+		__atomic_store_n(&nord2_smp_off_error[core], rc ? rc : -1, __ATOMIC_RELEASE);
+	}
+	for (;;) {
+		__asm__ volatile("wfe"); /* Failed OFF never returns to XNU or Linux. */
+	}
+}
+
+void
+nord2_smp_start_prepare(unsigned cpu)
+{
+	unsigned cpus = 0, stop = 0;
+	PE_parse_boot_argn("cpus", &cpus, sizeof(cpus));
+	PE_parse_boot_argn("nord2stopat", &stop, sizeof(stop));
+	bool allowed = (stop == 20 && (cpus == 2 || cpus == 4 || cpus == 8)) ||
+	    ((stop == 21 || stop == 22 || stop == 23) && cpus == 8 && nord2_smp_userland_config(stop));
+	if (!allowed || cpu == 0 || cpu >= cpus ||
+	    __atomic_load_n(&nord2_smp_stop_requested, __ATOMIC_ACQUIRE)) {
+		panic("NORD2 SMP: unsupported startup configuration cpu=%u cpus=%u stop=%u",
+		    cpu, cpus, stop);
+	}
+	if (!nord2_kernel_smp_active) {
+		/* This executes on CPU0 before the first secondary CPU_ON. */
+		if (nord2_raw_core() != 0) {
+			panic("NORD2 SMP: first startup requires CPU0");
+		}
+		__atomic_store_n(&nord2_kernel_smp_active, 1, __ATOMIC_RELEASE);
+		if (!nord2_psci_all_off()) {
+			panic("NORD2 SMP: inherited secondary not OFF");
+		}
+		printf("NORD2 SMP: coordinated return armed; requested=%u\n", cpus);
+	}
+}
+
+static int
+nord2_kernel_smp_prepare_return(void)
+{
+	if (!nord2_kernel_smp_active) {
+		return 0;
+	}
+	__atomic_store_n(&nord2_smp_stop_requested, 1, __ATOMIC_RELEASE);
+	unsigned core = nord2_raw_core();
+	sweet_early_string("NORD2 SMP: return caller CPU=0x");
+	nord2_hex64(core);
+	sweet_early_string("\n");
+	if (core != 0) {
+		nord2_smp_send_stop(0);
+		nord2_smp_off_self();
+	}
+	/* CPU0 alone may reuse the kernel memory for Linux. No scheduler locks
+	 * or callbacks: a secondary may have panicked before its startup finished. */
+	for (unsigned i = 1; i < 8; i++) {
+		nord2_smp_send_stop(i);
+	}
+	uint64_t deadline = nord2_psci_now() +
+	    __builtin_arm_rsr64("CNTFRQ_EL0") * 5;
+	do {
+		if (nord2_psci_all_off()) {
+			sweet_early_string("NORD2 SMP: XNU secondaries all OFF; CPU0 return permitted\n");
+			return 1;
+		}
+		nord2_psci_poll();
+	} while (nord2_psci_now() < deadline);
+	for (unsigned i = 1; i < 8; i++) {
+		int32_t affinity = nord2_psci_call(0xc4000004, i << 8, 0, 0);
+		if (affinity != 1) {
+			/* A stopped CPU may own a normal printf/console lock. */
+			sweet_early_string("NORD2 SMP: shutdown core=");
+			nord2_hex64(i);
+			sweet_early_string(" affinity=");
+			nord2_hex64((uint32_t)affinity);
+			sweet_early_string(" CPU_OFF_rc=");
+			nord2_hex64((uint32_t)__atomic_load_n(&nord2_smp_off_error[i], __ATOMIC_ACQUIRE));
+			sweet_early_string("\n");
+		}
+	}
+	return -1;
+}
+
+void
+nord2_smp_irq_stop(uint64_t iar)
+{
+	if (!nord2_kernel_smp_active ||
+	    !__atomic_load_n(&nord2_smp_stop_requested, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	/* IAR has already acknowledged this interrupt. Complete it before OFF
+	 * or before replacing the running kernel, regardless of its INTID. */
+	__builtin_arm_wsr("DAIFSet", 0xf);
+	__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	__builtin_arm_isb(ISB_SY);
+	if (nord2_raw_core() != 0) {
+		nord2_smp_off_self();
+	}
+	nord2_return_to_stock();
+}
+
+struct nord2_smp_work {
+	uint32_t ready, done, actual, ipi_reply;
+	uint64_t midr, before, after;
+};
+static struct nord2_smp_work nord2_smp_work[8];
+static uint32_t nord2_smp_go;
+static uint64_t nord2_smp_counter;
+static int nord2_smp_sleep_chan;
+extern kern_return_t thread_terminate(thread_t);
+
+static void
+nord2_smp_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&nord2_smp_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+nord2_smp_worker(void *arg, wait_result_t result __unused)
+{
+	unsigned core = (unsigned)(uintptr_t)arg;
+	struct nord2_smp_work *work = &nord2_smp_work[core];
+	(void)thread_bind(cpu_to_processor((int)core));
+	thread_block(THREAD_CONTINUE_NULL); /* Migrate to the bound processor. */
+	work->actual = (uint32_t)cpu_number();
+	work->midr = __builtin_arm_rsr64("MIDR_EL1");
+	work->before = __atomic_load_n(&nord2_cpu_ticks[core], __ATOMIC_RELAXED);
+	__atomic_store_n(&work->ready, 1, __ATOMIC_RELEASE);
+	uint64_t deadline = nord2_psci_now() +
+	    __builtin_arm_rsr64("CNTFRQ_EL0") * 5;
+	while (!__atomic_load_n(&nord2_smp_go, __ATOMIC_ACQUIRE) &&
+	    nord2_psci_now() < deadline) {
+		nord2_smp_sleep(1);
+	}
+	if (__atomic_load_n(&nord2_smp_go, __ATOMIC_ACQUIRE) && work->actual == core) {
+		for (unsigned round = 0; round < 16; round++) {
+			for (unsigned n = 0; n < 256; n++) {
+				__atomic_fetch_add(&nord2_smp_counter, 1, __ATOMIC_RELAXED);
+			}
+			nord2_smp_sleep(2); /* Exercise local timer wakeups repeatedly. */
+		}
+		work->after = __atomic_load_n(&nord2_cpu_ticks[core], __ATOMIC_RELAXED);
+		__atomic_store_n(&work->done, 1, __ATOMIC_RELEASE);
+	} else {
+		__atomic_store_n(&work->done, 2, __ATOMIC_RELEASE);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+	panic("NORD2 SMP: terminated worker returned");
+}
+
+static void
+nord2_smp_xcall(void *arg)
+{
+	struct nord2_smp_work *work = arg;
+	__atomic_store_n(&work->ipi_reply, (uint32_t)cpu_number() + 1, __ATOMIC_RELEASE);
+}
+
+static void
+nord2_kernel_smp_probe(void)
+{
+	unsigned cpus = 0, stop = 0;
+	bool pass = false;
+	PE_parse_boot_argn("cpus", &cpus, sizeof(cpus));
+	PE_parse_boot_argn("nord2stopat", &stop, sizeof(stop));
+	if (!nord2_kernel_smp_active || (cpus != 2 && cpus != 4 && cpus != 8) ||
+	    ml_get_cpu_count() != cpus) {
+		printf("NORD2 SMP: scheduler probe configuration refused\n");
+		goto done;
+	}
+	(void)thread_bind(cpu_to_processor(0));
+	thread_block(THREAD_CONTINUE_NULL);
+	if (cpu_number() != 0 || nord2_raw_core() != 0) {
+		panic("NORD2 SMP: diagnostic coordinator did not reach CPU0");
+	}
+	printf("NORD2 SMP: XNU scheduler probe begin; cpus=%u\n", cpus);
+	for (unsigned i = 0; i < cpus; i++) {
+		thread_t thread;
+		if (kernel_thread_start(nord2_smp_worker, (void *)(uintptr_t)i, &thread) != KERN_SUCCESS) {
+			printf("NORD2 SMP: worker creation failed core=%u\n", i);
+			goto done;
+		}
+		thread_deallocate(thread);
+	}
+	uint64_t deadline = nord2_psci_now() +
+	    __builtin_arm_rsr64("CNTFRQ_EL0") * 5;
+	bool ready;
+	do {
+		ready = true;
+		for (unsigned i = 0; i < cpus; i++) {
+			ready &= __atomic_load_n(&nord2_smp_work[i].ready, __ATOMIC_ACQUIRE) == 1;
+		}
+		if (!ready) {
+			nord2_smp_sleep(1);
+		}
+	} while (!ready && nord2_psci_now() < deadline);
+	if (!ready) {
+		printf("NORD2 SMP: worker readiness timeout\n");
+		goto done;
+	}
+	__atomic_store_n(&nord2_smp_go, 1, __ATOMIC_RELEASE);
+	for (unsigned i = 0; i < cpus; i++) {
+		if (cpu_xcall((int)i, nord2_smp_xcall, &nord2_smp_work[i]) != KERN_SUCCESS) {
+			printf("NORD2 SMP: cross-call failed core=%u\n", i);
+			goto done;
+		}
+	}
+	deadline = nord2_psci_now() + __builtin_arm_rsr64("CNTFRQ_EL0") * 5;
+	bool complete;
+	do {
+		complete = true;
+		for (unsigned i = 0; i < cpus; i++) {
+			complete &= __atomic_load_n(&nord2_smp_work[i].done, __ATOMIC_ACQUIRE) != 0 &&
+			    __atomic_load_n(&nord2_smp_work[i].ipi_reply, __ATOMIC_ACQUIRE) != 0;
+		}
+		if (!complete) {
+			nord2_smp_sleep(1);
+		}
+	} while (!complete && nord2_psci_now() < deadline);
+	unsigned passed = 0;
+	for (unsigned i = 0; i < cpus; i++) {
+		struct nord2_smp_work *w = &nord2_smp_work[i];
+		uint32_t finished = __atomic_load_n(&w->done, __ATOMIC_ACQUIRE);
+		uint32_t reply = __atomic_load_n(&w->ipi_reply, __ATOMIC_ACQUIRE);
+		uint64_t ticks = finished == 1 ? w->after - w->before : 0;
+		bool ok = finished == 1 && w->actual == i && reply == i + 1 && ticks > 0 &&
+		    ((w->midr >> 4) & 0xfff) == (i < 4 ? 0xd05 : 0xd41);
+		passed += ok;
+		printf("NORD2 SMP: worker=%u actual=%u MIDR=%llx done=%u ticks=%llu "
+		    "ipi_reply=%u ipi_irqs=%llu ok=%u\n", i, w->actual, w->midr,
+		    finished, ticks, reply,
+		    __atomic_load_n(&nord2_cpu_ipis[i], __ATOMIC_RELAXED), ok);
+	}
+	uint64_t total = __atomic_load_n(&nord2_smp_counter, __ATOMIC_ACQUIRE);
+	uint32_t dropped = __atomic_load_n(&nord2_console_dropped, __ATOMIC_RELAXED);
+	pass = complete && passed == cpus && total == cpus * 4096 && !dropped;
+	printf("NORD2 SMP: scheduler result %u/%u counter=%llu expected=%u "
+	    "console_dropped=%u PASS=%u\n", passed, cpus, total, cpus * 4096,
+	    dropped, pass);
+ done:
+	if ((stop == 21 || stop == 22 || stop == 23) && pass && cpus == 8 &&
+	    nord2_smp_userland_config(stop)) {
+		__atomic_store_n(&nord2_smp_userland_passed, 1, __ATOMIC_RELEASE);
+		(void)thread_bind(PROCESSOR_NULL);
+		if (stop == 21) {
+			printf("NORD2 SMP: all8 passed; continuing to USB and RAM userland\n");
+		} else if (stop == 22) {
+			printf("NORD2 SMP: all8 passed; continuing to USB and read-only iOS root\n");
+		} else if (nord2_smp_lane_diag_config()) {
+			printf("NORD2 SMP: all8 passed; continuing to read-only UFS lane diagnostic stop\n");
+		} else {
+			printf("NORD2 SMP: all8 passed; continuing to USB and writable iOS root\n");
+		}
+		return;
+	}
+	nord2_stop_at(stop, "after bounded XNU SMP scheduler probe");
+}
+/* END NORD2 XNU SMP */
+
+void
+nord2_ufs_snapshot(void)
+{
+	uint32_t want = 0;
+	(void)PE_parse_boot_argn("nord2stopat", &want, sizeof(want));
+	if (want != 10) {
+		return;
+	}
+	/*
+	 * Live Nord 2 DT: ufshci@11270000, reg size 0x2300.
+	 * Offsets from this phone's Linux drivers/scsi/ufs/ufshci.h.
+	 * Read standard status/configuration registers only; no controller
+	 * reset, interrupt acknowledgement, request submission or media write.
+	 */
+	static const struct { const char *name; uint32_t offset; } regs[] = {
+		{ "ufs_cap", 0x00 }, { "ufs_version", 0x08 },
+		{ "ufs_is", 0x20 }, { "ufs_ie", 0x24 },
+		{ "ufs_hcs", 0x30 }, { "ufs_hce", 0x34 },
+		{ "ufs_utrlba", 0x50 }, { "ufs_utrlbau", 0x54 },
+		{ "ufs_utrldbr", 0x58 }, { "ufs_utrlrsr", 0x60 },
+		{ "ufs_utmrlba", 0x70 }, { "ufs_utmrlbau", 0x74 },
+		{ "ufs_utmrldbr", 0x78 }, { "ufs_utmrlrsr", 0x80 },
+	};
+	uintptr_t base = ml_io_map(0x11270000UL, 0x2300);
+	if (base == 0) {
+		sweet_early_string("NORD2-XNU: UFS snapshot mapping failed\n");
+	} else {
+		sweet_early_string("NORD2-XNU: UFS snapshot begin (read-only)\n");
+		for (unsigned int i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+			uint32_t value = *(volatile const uint32_t *)(base + regs[i].offset);
+			nord2_wdt_log(regs[i].name, value);
+		}
+		sweet_early_string("NORD2-XNU: UFS snapshot end\n");
+	}
+	nord2_stop_at(10, "after read-only UFS host snapshot");
+}
+
+/*
+ * Remember the chain-back properties while the device tree is still
+ * reachable. arm_vm_init() switches the kernel page tables, after which the
+ * ADT (placed just past the kernel image) cannot be looked up any more; a
+ * panic later in that function would then have no way back to Android.
+ */
+void
+nord2_cache_chain_back(void)
+{
+	DTEntry chosen = NULL;
+	void const *prop;
+	unsigned int size;
+	uint64_t e = 0, d = 0, s = 0, x = 0;
+
+	if (nord2_cb_valid) {
+		return;
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess) {
+		sweet_early_string("NORD2-XNU: cache: no /chosen\n");
+		return;
+	}
+	if (SecureDTGetProperty(chosen, "nord2-stock-entry", &prop, &size) == kSuccess &&
+	    size == sizeof(uint64_t)) {
+		e = *(uint64_t const *)prop;
+	}
+	if (SecureDTGetProperty(chosen, "nord2-stock-dtb", &prop, &size) == kSuccess &&
+	    size == sizeof(uint64_t)) {
+		d = *(uint64_t const *)prop;
+	}
+	if (SecureDTGetProperty(chosen, "nord2-xnu-region", &prop, &size) == kSuccess &&
+	    size == 2 * sizeof(uint64_t)) {
+		s = ((uint64_t const *)prop)[0];
+		x = ((uint64_t const *)prop)[1];
+	}
+	if (e != 0 && d != 0 && s != 0 && x > s) {
+		nord2_cb_entry = e;
+		nord2_cb_dtb = d;
+		nord2_cb_start = s;
+		nord2_cb_end = x;
+		nord2_cb_valid = 1;
+		sweet_early_string("NORD2-XNU: chain-back cached\n");
+	} else {
+		sweet_early_string("NORD2-XNU: cache: bad properties\n");
+	}
+}
+
+void
+nord2_maybe_return(void)
+{
+	uint32_t stop = 1;
+
+	nord2_cache_chain_back();
+	nord2_fb_init();
+	(void)PE_parse_boot_argn("nord2stop", &stop, sizeof(stop));
+	if (!stop) {
+		sweet_early_string("NORD2-XNU: continuing past early stop\n");
+		return;
+	}
+	nord2_return_to_stock();
+}
+
+/*
+ * Second, independent stop point just before arm_vm_init(): lets the probe
+ * run processor_bootstrap() while keeping the Sweet memory-map code (PMAP,
+ * physmap, GIC/timer assumptions) out of the picture. nord2vm=1 enters it.
+ */
+void
+nord2_before_vm_init(void)
+{
