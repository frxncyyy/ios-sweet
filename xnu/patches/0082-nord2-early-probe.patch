+ if(!capture(o,c,s,5,11,0x5c,0x13,1,&s->raw_status[0])&&
+    !capture(o,c,s,6,11,0x5c,0x14,1,&s->raw_fault)&&
+    !capture(o,c,s,7,11,0x5c,0x13,1,&s->raw_status[1])&&
+    s->raw_status[0]<=255&&s->raw_status[1]<=255&&s->raw_fault<=255&&
