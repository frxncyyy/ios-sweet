+ if(!healthy(s) || rd(s,IS)){r->uncertain=1;return -1;}
+ if(power && ((r->last_hcs>>8)&7)!=1){r->uncertain=1;return -1;}
+ if(r->last_result)return -2;
+ if(!set)*value=observed;
+ return 0;
