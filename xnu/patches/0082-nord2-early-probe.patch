+static int allowed(uint16_t attr,int set)
+{
+ for(unsigned i=0;i<SNAP;i++)if(attrs[i]==attr)return 1;
+ if(!set)for(unsigned i=0;i<6;i++)if(caps[i]==attr)return 1;
+ return 0;
