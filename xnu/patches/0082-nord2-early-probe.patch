+/*
+ * Called from sleh_irq() for every acknowledged interrupt: proves the timer
+ * PPI is delivered once the scheduler runs (first 3 ticks, then every 256th
+ * up to the 2048th)
+ * and names the first few other INTIDs.
+ */
+extern uint32_t sweet_vtimer_intid;	/* pexpert/arm/pe_fiq.c */
+static uint64_t nord2_ticks;
+static unsigned int nord2_other_irqs;
+
+void
+nord2_irq_seen(uint32_t intid, uint64_t pc)
+{
+	if (nord2_wdt) {
+		nord2_wdt[2] = 0x1971;	/* WDT_RST: keep the SoC alive */
+	}
+	if (intid == sweet_vtimer_intid) {
+		nord2_ticks++;
+		/* Bounded, so a live timer cannot scroll the real last line away. */
+		if ((nord2_ticks & 0x3f) == 0 && nord2_wdt && nord2_ticks <= 256) {
+			nord2_wdt_log("wdt_mode", nord2_wdt[0]);
+			nord2_wdt_log("wdt_length", nord2_wdt[1]);
+			nord2_wdt_log("wdt_status", nord2_wdt[3]);
+		}
+		if (nord2_ticks <= 3 || ((nord2_ticks & 0x3f) == 0 && nord2_ticks <= 2048)) {
+			sweet_early_string("NORD2-XNU: timer tick 0x");
+			nord2_hex64(nord2_ticks);
+			sweet_early_string(" pc=0x");
+			nord2_hex64(pc);
+			sweet_early_string("\n");
+		}
+	} else if (nord2_other_irqs < 8) {
+		nord2_other_irqs++;
+		sweet_early_string("NORD2-XNU: irq intid 0x");
+		nord2_hex64(intid);
+		sweet_early_string("\n");
+	}
