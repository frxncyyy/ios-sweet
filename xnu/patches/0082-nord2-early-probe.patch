+    if(depth==1&&has(v,n,"mediatek,MT6893"))root_compatible=1;
+    if(has(v,n,"connfem"))return -1;
+   }
+   off=(off+n+3u)&~(size_t)3;
+  }else if(token==4){}
+  else if(token==9){if(depth||off!=end)return -1;ended=1;break;}
+  else return -1;
+ }
