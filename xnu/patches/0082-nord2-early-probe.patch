+static int ncd_normal_owner_window(const struct nwfn_native *);
+#define NWFN_NORMAL_LEASE(n) ncd_normal_owner_window(n)
+#include "wifi_main_wfdma_bind.inc"
+#undef NWFN_NORMAL_LEASE
