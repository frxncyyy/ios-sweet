 /*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
- * per-CPU state: panic() can reach this before a current thread exists.
- * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
- * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
- * retain this console until the normal framebuffer serial console is ready.
+ * Early bootstrap console. No allocation, locks, ADT parsing or per-CPU
+ * state: panic() can reach this before a current thread exists.
+ *
+ * SWEET (Qualcomm): start.s maps the splash framebuffer VA=PA as Normal
+ * Non-Cacheable memory and this file draws text into it. arm_vm_init
+ * installs a reserved kernel VA alias before removing TTBR0.
+ *
+ * NORD2 (MediaTek MT6893): the panel is DSI command mode, so writing to a
+ * framebuffer does not update the screen. The console instead appends to the
+ * ramoops pmsg ring at 0x48160000 (64 KiB, the last zone of the pstore
+ * reservation). start.s maps the 32 MiB block containing it VA=PA as Normal
+ * Non-Cacheable, so the same physical address is valid with the MMU off and
+ * on; Android reads the result as /sys/fs/pstore/pmsg-ramoops-0 after the
+ * next boot. The loader validates the live FDT before jumping here.
  */
 #include <arm64/sweet_early.h>
 
 #if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
+#if defined(NORD2)
+#include <arm/pmap/pmap.h>
+#include <arm/machine_routines.h>
+#include <arm64/tlb.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
