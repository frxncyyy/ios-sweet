+ s->barriers++;
+ for(uint32_t off=0;off<t->length;off+=4){
+  uint32_t physical=(t->space==NMT_AP2WF_WINDOW?WINDOW_PA:t->host_physical)+off;
+  uint32_t value=0,expected=le32(t->data+off);
