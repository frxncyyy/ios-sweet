+static int rd(const struct nwdp_io *o,void *c,struct nwdp_state *s,uint32_t a,uint32_t *v){
+ if(o->owner(c)){s->error=1;return -1;}
+ if(o->read32(c,a,v)){s->error=2;return -1;}
+ s->reads++;return 0;
