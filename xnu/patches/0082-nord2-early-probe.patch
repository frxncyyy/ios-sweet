+ printf("NORD2 WIFI MAIN FINISH ARM: spans=%#x cal=%u coex=%u cid=%#x\n",
+  nfp_native.state.completed,nfa_native.exchange.backup_valid,
+  nfp_native.coex_done,0x41u);
