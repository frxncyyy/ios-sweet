+ for(unsigned i=0;i<SNAP;i++) {
+  uint32_t expected=(i==1||i==4)?lanes:i==8?adapt:saved[i];
+  if(actual[i]!=expected)return -2;
+ }
+ return 0;
+}
+static int set_value(struct run *s,unsigned index,uint32_t value)
+{return uic(s,attrs[index],1,&value);}
