+/*
+ * Bounded gate for the Nord2 arm_vm_init bring-up. The riskiest code of the
+ * port cannot be allowed to run into a hang: a hang loses the pmsg log
+ * because the reset that follows clears DRAM. Each gate therefore stops
+ * (logging NORD2-NEXT=<stage+1> for the loader to pick up) unless the boot
+ * argument nord2vmstop is 0 or greater than the gate's stage. Reboots then
+ * walk the gates one at a time, and the last NORD2-NEXT seen before a hang
+ * names the failing step.
+ *
+ * To avoid a phone reboot per gate, every gate below the last one returns to
+ * the *loader* (which is still intact at LK's kernel load address) instead of
+ * the stock kernel: the loader re-reads the ring, advances the gate and
+ * re-enters XNU. Only the final gate hands control to the stock kernel, so
+ * the whole walk happens in one power-on and Android then boots with the full
+ * log.
+ */
+#define NORD2_LOADER_PA 0x40080000UL
+#define NORD2_LAST_GATE 15
+
+void
+nord2_vm_gate(unsigned int stage)
+{
+	uint32_t stop = 0;
+	uint32_t loop = 0;
+
+
+	(void)PE_parse_boot_argn("nord2vmstop", &stop, sizeof(stop));
+	(void)PE_parse_boot_argn("nord2vmloop", &loop, sizeof(loop));
+	if (stop == 0 || stage < stop) {
+		return;
+	}
+	int to_loader = (loop != 0 && stage < loop && stage < NORD2_LAST_GATE);
+	sweet_early_string("NORD2-XNU: gate 0x");
+	nord2_hex64(stage);
+	sweet_early_string(" stop; NORD2-NEXT=0x");
+	nord2_hex64(stage + 1);
+	sweet_early_string(to_loader ? "; loop to loader\n" : "\n");
+	nord2_leave_to(to_loader ? NORD2_LOADER_PA : 0);
+}
