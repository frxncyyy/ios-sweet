+  if(nwfn_owner(&nwfn_native))return halt();
+  nfp_native.ready_raw=*(volatile const uint32_t *)(nfp_native.host_io+0xf0);
+  nfp_native.ready_polls++;
+  if((nfp_native.ready_raw&3u)==3u){nfp_native.ready=1;return 0;}
+ }
+ return halt();
+}
