--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,16 +1,709 @@
 /*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
- * per-CPU state: panic() can reach this before a current thread exists.
- * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
- * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
- * retain this console until the normal framebuffer serial console is ready.
+ * Early bootstrap console. No allocation, locks, ADT parsing or per-CPU
+ * state: panic() can reach this before a current thread exists.
+ *
+ * SWEET (Qualcomm): start.s maps the splash framebuffer VA=PA as Normal
+ * Non-Cacheable memory and this file draws text into it. arm_vm_init
+ * installs a reserved kernel VA alias before removing TTBR0.
+ *
+ * NORD2 (MediaTek MT6893): the panel is DSI command mode, so writing to a
+ * framebuffer does not update the screen. The console instead appends to the
+ * ramoops pmsg ring at 0x48160000 (64 KiB, the last zone of the pstore
+ * reservation). start.s maps the 32 MiB block containing it VA=PA as Normal
+ * Non-Cacheable, so the same physical address is valid with the MMU off and
+ * on; Android reads the result as /sys/fs/pstore/pmsg-ramoops-0 after the
+ * next boot. The loader validates the live FDT before jumping here.
  */
 #include <arm64/sweet_early.h>
 
 #if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
+#if defined(NORD2)
+#include <arm/pmap/pmap.h>
+#include <arm/machine_routines.h>
+#include <arm64/tlb.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <kern/clock.h>
+#include <kern/debug.h>
+#include <kern/cpu_number.h>
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#endif
 
+#if defined(NORD2)
+/*
+ * Verified against dtb/nord2/live.dts: pstore is 0x48090000+0xe0000 and pmsg
+ * is its last 64 KiB zone. The ring header is the Linux persistent_ram_buffer
+ * {u32 sig, atomic_t start, atomic_t size}; sig 0x43474244 is "DBGC".
+ */
+#define NORD2_PMSG_BASE 0x48160000UL
+#define NORD2_PMSG_SIZE 0x10000UL
+#define NORD2_PMSG_SIG  0x43474244UL
+#define NORD2_RING_HDR  12UL
+
+struct nord2_ring {
+	volatile uint32_t sig;
+	volatile uint32_t start;
+	volatile uint32_t size;
+	volatile char data[];
+};
+
+/* ---- phase-2 on-screen console (DISPLAY-LOG.md) ------------------------ */
+#define NORD2_FB_PA      0x76e10000UL	/* active buffer, phase 1 */
+#define NORD2_FB_PITCH   4352u		/* 1088 px * 4 B */
+#define NORD2_FB_WIDTH   1080u
+#define NORD2_FB_HEIGHT  2400u
+#define NORD2_DSI0       0x1400e000UL
+#define NORD2_DISP_MUTEX 0x14117000UL
+
+#define NORD2_DSI_START   0x00u
+#define NORD2_DSI_INTSTA  0x0cu
+#define NORD2_DSI_FRAME_DONE (1u << 4)
+#define NORD2_DSI_BUSY       (1u << 31)
+#define NORD2_MUTEX_EN0   0x20u
+
+#define NORD2_FB_CELL_W 16u
+#define NORD2_FB_CELL_H 32u
+/* The log lives in the bottom band of the panel: the last line is always the
+ * bottom-most one, which is what matters for a boot that never returns. */
+#define NORD2_FB_ROWS   32u
+#define NORD2_FB_ORIGIN_Y (NORD2_FB_HEIGHT - NORD2_FB_ROWS * NORD2_FB_CELL_H)
+
+extern unsigned char iso_font[256 * 16];
+static void sweet_early_string(const char *s);
+static uintptr_t nord2_phys(uintptr_t pa);
+
+static int nord2_fb_state = -1;	/* -1 undecided, 0 off, 1 on */
+static int nord2_fb_started;
+/* Opt-in diagnostic: keep log sinks intact while avoiding framebuffer copies. */
+static uint32_t nord2_fastlog;
+static uint64_t nord2_fb_begin_ticks, nord2_fb_draw_ticks;
+static uint64_t nord2_fb_scrolls, nord2_fb_pushes;
+static uint32_t nord2_gui_owned;
+static void nord2_stream_init(void);
+static unsigned int nord2_fb_row, nord2_fb_col;
+
+static int
+nord2_fb_on(void)
+{
+	/* Never parse boot arguments here: this runs from the very first marker,
+	 * before PE_init_platform() has set them up (that faulted once). */
+	return nord2_fb_state > 0;
+}
+
+/*
+ * Called from the stage-6 stop, where boot arguments and the device tree are
+ * both valid. Enables the on-screen console when the boot argument nord2fb=1
+ * is present.
+ */
+/*
+ * Private identity (V=P) tables for the blocks the console and the chain-back
+ * need. XNU reuses its bootstrap tables after arm_vm_init(), which is why the
+ * log went silent once the kernel took over; these tables live in our own BSS
+ * and stay valid for the whole boot.
+ *
+ *   L2[10]  0x14000000  display MMIO        Device-nGnRnE
+ *   L2[36]  0x48000000  ramoops pmsg ring   Normal Non-Cacheable
+ *   L2[59]  0x76000000  framebuffer         Normal Non-Cacheable
+ *   L2[60]  0x78000000  framebuffer         Normal Non-Cacheable
+ *   L2[161..190]        XNU RAM window      Normal write-back
+ */
+#define NORD2_TT_ENTRIES 2048
+
+#define N2_VALID   (1ULL << 0)
+#define N2_TABLE   (3ULL << 0)
+#define N2_ATTR(i) ((uint64_t)(i) << 2)
+#define N2_SH_IN   (3ULL << 8)
+#define N2_AF      (1ULL << 10)
+#define N2_PXN     (1ULL << 53)
+#define N2_UXN     (1ULL << 54)
+#define N2_NORMAL  (N2_VALID | N2_ATTR(0) | N2_SH_IN | N2_AF | N2_UXN)
+#define N2_NC      (N2_VALID | N2_ATTR(1) | N2_SH_IN | N2_AF | N2_UXN)
+#define N2_DEV     (N2_VALID | N2_ATTR(3) | N2_AF | N2_PXN | N2_UXN)
+
+static uint64_t nord2_l1[NORD2_TT_ENTRIES] __attribute__((aligned(16384)));
+static uint64_t nord2_l2[NORD2_TT_ENTRIES] __attribute__((aligned(16384)));
+uint64_t nord2_l1_pa;	/* physical address of the table, set at stage 6 */
+static volatile uint32_t *nord2_wdt;
+/* Timer-stall probe: if the tick counter no longer advances while the kernel
+ * keeps printing, is the architected timer still armed? */
+static uint64_t nord2_ticks;
+static unsigned int nord2_chars, nord2_stall_reports;
+static uint32_t nord2_tick_snapshot;
+
+/*
+ * Kernel-VA aliases of the blocks the console touches, created by
+ * nord2_console_remap() right after arm_vm_init(). Until then the console runs
+ * through the bootstrap V=P map in TTBR0. That map is only in TTBR0 until the
+ * first context switch: pmap_switch_user_ttb() then loads invalid_ttep for
+ * kernel threads, so V=P addresses fault from there on (the silence after
+ * "SWEET BATTERY"). io_map() aliases live in TTBR1 and survive every switch.
+ */
+static void nord2_hex64(uint64_t v);
+static uintptr_t nord2_va_pmsg, nord2_va_fb, nord2_va_dsi, nord2_va_mutex;
+
+#define NORD2_FB_SIZE (NORD2_FB_PITCH * NORD2_FB_HEIGHT)
+
+static uintptr_t
+nord2_phys(uintptr_t pa)
+{
+	if (nord2_va_pmsg && pa >= NORD2_PMSG_BASE && pa < NORD2_PMSG_BASE + NORD2_PMSG_SIZE) {
+		return nord2_va_pmsg + (pa - NORD2_PMSG_BASE);
+	}
+	if (nord2_va_fb && pa >= NORD2_FB_PA && pa < NORD2_FB_PA + NORD2_FB_SIZE) {
+		return nord2_va_fb + (pa - NORD2_FB_PA);
+	}
+	if (nord2_va_dsi && pa >= NORD2_DSI0 && pa < NORD2_DSI0 + 0x1000) {
+		return nord2_va_dsi + (pa - NORD2_DSI0);
+	}
+	if (nord2_va_mutex && pa >= NORD2_DISP_MUTEX && pa < NORD2_DISP_MUTEX + 0x1000) {
+		return nord2_va_mutex + (pa - NORD2_DISP_MUTEX);
+	}
+	return pa;	/* bootstrap V=P map */
+}
+
+/* Called from arm_init() right after arm_vm_init(), before serial_init(). */
+static void
+nord2_wdt_log(const char *name, uint32_t v)
+{
+	sweet_early_string("NORD2-XNU: ");
+	sweet_early_string(name);
+	sweet_early_string("=0x");
+	for (int i = 7; i >= 0; i--) {
+		unsigned int d = (v >> (i * 4)) & 0xf;
+		sweet_early_putc((char)(d < 10 ? '0' + d : 'a' + d - 10));
+	}
+	sweet_early_string("\n");
+}
+
+void
+nord2_console_remap(void)
+{
+	uintptr_t pmsg = ml_io_map_wcomb(NORD2_PMSG_BASE, NORD2_PMSG_SIZE);
+	uintptr_t fb = ml_io_map_wcomb(NORD2_FB_PA, NORD2_FB_SIZE);
+	uintptr_t dsi = ml_io_map(NORD2_DSI0, 0x1000);
+	uintptr_t mtx = ml_io_map(NORD2_DISP_MUTEX, 0x1000);
+
+	/* MediaTek top-level watchdog (toprgu): LK may leave it armed. */
+	nord2_wdt = (volatile uint32_t *)ml_io_map(0x10007000, 0x1000);
+	if (nord2_wdt) {
+		nord2_wdt_log("wdt_mode", nord2_wdt[0]);
+		nord2_wdt_log("wdt_length", nord2_wdt[1]);
+		nord2_wdt_log("wdt_status", nord2_wdt[3]);
+		nord2_wdt[2] = 0x1971;	/* WDT_RST (0x08): kick the AP watchdog */
+	}
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+	/* Switch over only once every alias exists. */
+	nord2_va_dsi = dsi;
+	nord2_va_mutex = mtx;
+	nord2_va_fb = fb;
+	nord2_va_pmsg = pmsg;
+	nord2_stream_init();
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_string("NORD2-XNU: console remapped to kernel VA, pmsg=0x");
+	nord2_hex64(pmsg);
+	sweet_early_string(" fb=0x");
+	nord2_hex64(fb);
+	sweet_early_string("\n");
+}
+
+void
+nord2_identity_init(void)
+{
+	struct boot_args *ba = (struct boot_args *)PE_boot_args();
+	uint64_t delta;
+
+	if (!ba) {
+		return;
+	}
+	delta = ba->physBase - ba->virtBase;	/* pa = va + delta */
+	for (unsigned int i = 0; i < NORD2_TT_ENTRIES; i++) {
+		nord2_l1[i] = 0;
+		nord2_l2[i] = 0;
+	}
+	nord2_l1[0] = ((uint64_t)(uintptr_t)nord2_l2 + delta) | N2_TABLE;
+	nord2_l2[10] = 0x14000000ULL | N2_DEV;
+	nord2_l2[36] = 0x48000000ULL | N2_NC;
+	nord2_l2[59] = 0x76000000ULL | N2_NC;
+	nord2_l2[60] = 0x78000000ULL | N2_NC;
+	for (unsigned int i = 161; i <= 190; i++) {
+		nord2_l2[i] = ((uint64_t)i << 25) | N2_NORMAL;
+	}
+	__asm__ volatile("dsb sy; ic iallu; dsb sy; isb" ::: "memory");
+	nord2_l1_pa = (uint64_t)(uintptr_t)nord2_l1 + delta;
+	sweet_early_string("NORD2-XNU: identity tables installed\n");
+}
+
+void
+nord2_fb_init(void)
+{
+	uint32_t v = 0;
+
+	if (nord2_fb_state >= 0) {
+		return;
+	}
+	nord2_fb_state = PE_parse_boot_argn("nord2fb", &v, sizeof(v)) && v;
+	PE_parse_boot_argn("nord2fastlog", &nord2_fastlog, sizeof(nord2_fastlog));
+	nord2_fb_begin_ticks = __builtin_arm_rsr64("CNTVCT_EL0");
+	if (nord2_fb_state && !nord2_fb_started) {
+		sweet_early_string("NORD2-XNU: on-screen log active\n");
+	}
+}
+
+static void
+nord2_fb_fill(uint32_t px)
+{
+	volatile uint32_t *fb = (volatile uint32_t *)nord2_phys(NORD2_FB_PA);
+	for (unsigned int y = 0; y < NORD2_FB_HEIGHT; y++) {
+		volatile uint32_t *line = fb + y * (NORD2_FB_PITCH / 4);
+		for (unsigned int x = 0; x < NORD2_FB_WIDTH; x++) {
+			line[x] = px;
+		}
+	}
+}
+
+static void
+nord2_fb_clear_row(void)
+{
+	volatile uint32_t *fb = (volatile uint32_t *)(nord2_phys(NORD2_FB_PA) +
+	    (NORD2_FB_ORIGIN_Y + nord2_fb_row * NORD2_FB_CELL_H) * NORD2_FB_PITCH);
+	for (unsigned int y = 0; y < NORD2_FB_CELL_H; y++) {
+		volatile uint32_t *line = fb + y * (NORD2_FB_PITCH / 4);
+		for (unsigned int x = 0; x < NORD2_FB_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+/*
+ * One frame per line, exactly as the command-mode panel needs it: bounded
+ * waits only, so a misbehaving engine can never turn the log into a hang.
+ */
+static void
+nord2_fb_push(void)
+{
+	nord2_fb_pushes++;
+	volatile uint32_t *dsi = (volatile uint32_t *)nord2_phys(NORD2_DSI0);
+	volatile uint32_t *mtx = (volatile uint32_t *)nord2_phys(NORD2_DISP_MUTEX);
+
+	for (unsigned int i = 0; i < 100000; i++) {
+		if (!(dsi[NORD2_DSI_INTSTA / 4] & NORD2_DSI_BUSY)) {
+			break;
+		}
+	}
+	mtx[NORD2_MUTEX_EN0 / 4] = 1;
+	dsi[NORD2_DSI_START / 4] = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	dsi[NORD2_DSI_START / 4] = 1;
+	for (unsigned int i = 0; i < 200000; i++) {
+		if (dsi[NORD2_DSI_INTSTA / 4] & NORD2_DSI_FRAME_DONE) {
+			break;
+		}
+	}
+	dsi[NORD2_DSI_INTSTA / 4] = NORD2_DSI_FRAME_DONE;
+}
+
+static void
+nord2_fb_scroll(void)
+{
+	nord2_fb_scrolls++;
+	volatile uint32_t *fb = (volatile uint32_t *)nord2_phys(NORD2_FB_PA);
+	const unsigned int src = NORD2_FB_ORIGIN_Y + NORD2_FB_CELL_H;
+	const unsigned int lines = (NORD2_FB_ROWS - 1) * NORD2_FB_CELL_H;
+
+	for (unsigned int y = 0; y < lines; y++) {
+		volatile uint32_t *s = fb + (src + y) * (NORD2_FB_PITCH / 4);
+		volatile uint32_t *d = fb + (NORD2_FB_ORIGIN_Y + y) * (NORD2_FB_PITCH / 4);
+		for (unsigned int x = 0; x < NORD2_FB_WIDTH; x++) {
+			d[x] = s[x];
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	nord2_fb_row = NORD2_FB_ROWS - 1;
+	nord2_fb_clear_row();
+}
+
+static void
+nord2_fb_newline(void)
+{
+	nord2_fb_col = 0;
+	if (nord2_fastlog && !panic_active()) {
+		/* Circular console: one row clear instead of 31 rows read+copied.
+		 * A blank following row marks the cursor; panic keeps normal scroll. */
+		nord2_fb_row = (nord2_fb_row + 1) % NORD2_FB_ROWS;
+		nord2_fb_clear_row();
+		uint32_t current = nord2_fb_row;
+		nord2_fb_row = (current + 1) % NORD2_FB_ROWS;
+		nord2_fb_clear_row();
+		nord2_fb_row = current;
+	} else if (nord2_fb_row + 1 >= NORD2_FB_ROWS) {
+		nord2_fb_scroll();
+	} else {
+		nord2_fb_row++;
+		nord2_fb_clear_row();
+	}
+}
+
+static void
+nord2_fb_putc(char c)
+{
+	if (!nord2_fb_on() || (nord2_gui_owned && !panic_active())) {
+		return;
+	}
+	if (c == '\r') {
+		return;
+	}
+	if (!nord2_fb_started) {
+		nord2_fb_started = 1;
+		nord2_fb_fill(0xff000000u);
+	}
+	if (c == '\n') {
+		nord2_fb_newline();
+		nord2_fb_push();
+		return;
+	}
+	if (nord2_fb_col >= NORD2_FB_WIDTH / NORD2_FB_CELL_W) {
+		nord2_fb_newline();
+	}
+	const unsigned char *g = iso_font + (unsigned char)c * 16;
+	volatile uint32_t *base = (volatile uint32_t *)(nord2_phys(NORD2_FB_PA) +
+	    (NORD2_FB_ORIGIN_Y + nord2_fb_row * NORD2_FB_CELL_H) * NORD2_FB_PITCH +
+	    nord2_fb_col * NORD2_FB_CELL_W * 4);
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		unsigned int bits = g[gy];
+		for (unsigned int sy = 0; sy < 2; sy++) {
+			volatile uint32_t *line = base +
+			    (gy * 2 + sy) * (NORD2_FB_PITCH / 4);
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t px = (bits & (1u << gx)) ?
+				    0xffffffffu : 0xff000000u;
+				line[gx * 2] = px;
+				line[gx * 2 + 1] = px;
+			}
+		}
+	}
+	nord2_fb_col++;
+}
+
+/*
+ * Before arm_vm_init() switches the page tables the pmsg block and the
+ * framebuffer are reachable at their physical addresses (the bootstrap V=P
+ * map, kept in TTBR0 for NORD2). Afterwards that map is no longer reliable, so
+ * the same physical pages are addressed through the kernel physmap instead.
+ */
+
+
+static volatile struct nord2_ring *
+nord2_ring(void)
+{
+	return (volatile struct nord2_ring *)nord2_phys(NORD2_PMSG_BASE);
+}
+
+/* Read only published pmsg bytes; the diagnostic log saturates, never wraps. */
+uint32_t
+nord2_log_read(uint32_t offset, uint8_t *out, uint32_t max)
+{
+	volatile struct nord2_ring *ring = nord2_ring();
+	uint32_t size = ring->size;
+	/* Pair with publication in nord2_putc. Published bytes never change. */
+	__builtin_arm_dmb(DMB_SY);
+	if (ring->sig != NORD2_PMSG_SIG || size > NORD2_PMSG_SIZE - NORD2_RING_HDR ||
+	    offset >= size) {
+		return 0;
+	}
+	uint32_t count = size - offset < max ? size - offset : max;
+	for (uint32_t i = 0; i < count; i++) {
+		out[i] = (uint8_t)ring->data[offset + i];
+	}
+	return count;
+}
+
+static volatile struct nord2_ring *nord2_log =
+    (volatile struct nord2_ring *)NORD2_PMSG_BASE;
+static unsigned int nord2_pos;
+static unsigned int nord2_started;
+static int nord2_leaving;
+/* Chain-back parameters read while the device tree was still reachable. */
+static uint64_t nord2_cb_entry, nord2_cb_dtb, nord2_cb_start, nord2_cb_end;
+static int nord2_cb_valid;
+/* Enabled only immediately before the first secondary enters XNU, with MMU
+ * and coherent kernel mappings established. Early physical console stays
+ * free of atomic read-modify-write instructions. */
+static volatile uint32_t nord2_kernel_smp_active;
+static uint32_t nord2_console_owner, nord2_console_dropped;
+static uint64_t nord2_cpu_ticks[8], nord2_cpu_ipis[8];
+static int nord2_kernel_smp_prepare_return(void);
+static void nord2_kernel_smp_probe(void);
+
+static unsigned
+nord2_raw_core(void)
+{
+	return (unsigned)((__builtin_arm_rsr64("MPIDR_EL1") >> 8) & 0xff);
+}
+
+static bool
+nord2_console_acquire(unsigned owner, bool *outer)
+{
+	*outer = false;
+	uint64_t deadline = __builtin_arm_rsr64("CNTVCT_EL0") +
+	    __builtin_arm_rsr64("CNTFRQ_EL0") / 20;
+	do {
+		uint32_t expected = 0;
+		if (__atomic_compare_exchange_n(&nord2_console_owner, &expected,
+		    owner, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+			*outer = true;
+			return true;
+		}
+		if (expected == owner) {
+			return true; /* Same-core recursion, interrupts already masked. */
+		}
+		__asm__ volatile("yield");
+	} while (__builtin_arm_rsr64("CNTVCT_EL0") < deadline);
+	/* A faulting owner must not deadlock another core's panic/return. */
+	__atomic_fetch_add(&nord2_console_dropped, 1, __ATOMIC_RELAXED);
+	return false;
+}
+
+/* Extended live log in ordinary coherent RAM; persistent pmsg stays unchanged.
+ * Writers use the console lock, readers see only immutable published bytes.
+ * Initialized after the final mappings exist, before any secondary starts. */
+#define NORD2_STREAM_CAPACITY (4u * 1024u * 1024u)
+static uint8_t nord2_stream[NORD2_STREAM_CAPACITY];
+static uint32_t nord2_stream_size;
+static bool nord2_stream_ready;
+
+static void
+nord2_stream_init(void)
+{
+	uint32_t n = nord2_log_read(0, nord2_stream, NORD2_PMSG_SIZE - NORD2_RING_HDR);
+	__atomic_store_n(&nord2_stream_size, n, __ATOMIC_RELEASE);
+	nord2_stream_ready = true;
+}
+
+void
+nord2_log_stream_info(uint32_t info[2])
+{
+	info[0] = NORD2_STREAM_CAPACITY;
+	info[1] = __atomic_load_n(&nord2_stream_size, __ATOMIC_ACQUIRE);
+}
+
+uint32_t
+nord2_log_stream_read(uint32_t offset, uint8_t *out, uint32_t max)
+{
+	uint32_t size = __atomic_load_n(&nord2_stream_size, __ATOMIC_ACQUIRE);
+	if (offset >= size) { return 0; }
+	uint32_t n = size - offset < max ? size - offset : max;
+	for (uint32_t i = 0; i < n; i++) { out[i] = nord2_stream[offset + i]; }
+	return n;
+}
+
