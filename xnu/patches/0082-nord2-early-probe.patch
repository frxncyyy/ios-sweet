+#if defined(NORD2)
+/*
+ * Console sink for serial_console.c: every byte the kernel would have sent to
+ * a video or serial console is appended to the same pmsg ring as the markers.
+ * Before console_init() the kernel calls _cnputs directly, so this captures
+ * the early dprintf output (and panics) on a board with no usable console.
+ */
+void
+sweet_early_console_write(const char *c, int size)
+{
+	for (int i = 0; i < size; i++) {
+		nord2_putc(c[i]);
+	}
+}
+
+/*
+ * Phase 1 of shim/nord2-xnu/DISPLAY-LOG.md: read-only dump of the display
+ * state LK leaves behind. start.s maps 0x14000000..0x141fffff Device-nGnRnE
+ * in the bootstrap V=P table, so these physical addresses are valid VAs here.
+ * Nothing is written: no MUTEX_EN, no DSI_START, no OVL register.
+ */
+#define NORD2_DSI0_BASE   0x1400e000UL
+#define NORD2_MUTEX_BASE  0x14117000UL
+#define NORD2_OVL0_BASE   0x14000000UL
+#define NORD2_OVL0L_BASE  0x14001000UL
+#define NORD2_OVL1_BASE   0x14100000UL
+#define NORD2_OVL1L_BASE  0x14101000UL
+
+static uint32_t
+nord2_rd32(uintptr_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static void
+nord2_hex32(uint32_t v)
+{
+	for (int i = 7; i >= 0; i--) {
+		unsigned int d = (v >> (i * 4)) & 0xf;
+		sweet_early_putc((char)(d < 10 ? '0' + d : 'a' + d - 10));
+	}
+}
+
+static void
+nord2_kv(const char *k, uint32_t v)
+{
+	sweet_early_putc(' ');
+	sweet_early_string(k);
+	sweet_early_putc('=');
+	nord2_hex32(v);
+}
+
+static void
+nord2_ovl_dump(const char *name, uintptr_t base)
+{
+	sweet_early_string("NORD2-DISP OVL ");
+	sweet_early_string(name);
+	nord2_kv("EN", nord2_rd32(base + 0x0c));
+	nord2_kv("ROI", nord2_rd32(base + 0x20));
+	nord2_kv("SRC", nord2_rd32(base + 0x2c));
+	sweet_early_putc('\n');
+	for (unsigned int l = 0; l < 4; l++) {
+		uintptr_t o = base + 0x20 * l;
+		sweet_early_string("NORD2-DISP LAY ");
+		sweet_early_string(name);
