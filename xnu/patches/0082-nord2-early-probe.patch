+  s->stage=g?NPP_SET0:NPP_SET1;s->set_attempted|=1u<<g;s->possibly_locked=1;
+  if(check(o,c,s)||o->smc(c,req[g].x,s->raw[g]))return fail(s,-14);
+  s->raw_valid|=1u<<g;if(s->raw[g][0])return fail(s,-15);s->set_accepted++;
