+  if(q->interface_name[i]!=name[i])return -1;
+  if(!name[i])terminated=1;
+ }
+ if(!terminated||!name[0])return -1;
+ if(q->request==13)value=state==NIWS_SCANNING?1u:0u;
+ else if(q->request==15)value=1;
+ else return -1;
