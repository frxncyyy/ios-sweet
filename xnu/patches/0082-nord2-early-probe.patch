+ int rc=nbg_i2c_read(&io,0,s,bus,slave,cmd,bytes,out);
+ report_bus(bus,rc,s);return rc;
+}
+static int ms(void *,unsigned n){if(n!=10)return -1;delay(10000);return 0;}
