+		if (attr == nord2_ufs_attrs[i]) { allowed = true; }
+	}
+	for (unsigned i = 0; i < N2_LIMIT_COUNT; i++) {
+		if (attr == nord2_ufs_limit_attrs[i]) { allowed = true; }
+	}
+	if (!allowed || !value || !result || !nord2_ufs_profile_enabled) { return EPERM; }
