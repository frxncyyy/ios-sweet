 void
 sweet_early_disable(void)
 {
+#if defined(NORD2)
+	/* Nothing to tear down: the pmsg ring stays valid in the kernel map. */
+	nord2_flush();
+#else
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+
+#if defined(NORD2)
+/*
+ * Leave XNU and resume the stock Android kernel that the loader preserved at
+ * a 2 MiB offset. Everything is validated by the loader, which writes the
+ * entry and device-tree physical addresses into /chosen.
+ */
+extern uint8_t bootstrap_pagetables[];
+extern void nord2_leave_xnu(uint64_t entry_pa, uint64_t dtb_pa,
+    uint64_t cache_start, uint64_t cache_end, uint64_t tramp_pa)
+    __attribute__((noreturn));
+
+void
+nord2_leave_to(uint64_t entry_override)
+{
+	DTEntry chosen = NULL;
+	void const *prop;
+	unsigned int size;
+	uint64_t entry = 0, dtb = 0;
+	uint64_t region_start = 0, region_end = 0;
+
+	nord2_leaving = 1;
+	/* Mask everything now: a context switch would reload TTBR0 below. */
+	__builtin_arm_wsr("DAIFSet", 0xf);
+	__builtin_arm_isb(ISB_SY);
+
+	/*
+	 * Prefer the parameters cached at the cpu_init stop: once arm_vm_init()
+	 * has switched tables, a device-tree lookup can itself fault.
+	 */
+	if (nord2_cb_valid) {
+		entry = nord2_cb_entry;
+		dtb = nord2_cb_dtb;
+		region_start = nord2_cb_start;
+		region_end = nord2_cb_end;
+	} else if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess) {
+		if (SecureDTGetProperty(chosen, "nord2-stock-entry", &prop, &size) == kSuccess &&
+		    size == sizeof(uint64_t)) {
+			entry = *(uint64_t const *)prop;
+		}
+		if (SecureDTGetProperty(chosen, "nord2-stock-dtb", &prop, &size) == kSuccess &&
+		    size == sizeof(uint64_t)) {
+			dtb = *(uint64_t const *)prop;
+		}
+		if (SecureDTGetProperty(chosen, "nord2-xnu-region", &prop, &size) == kSuccess &&
+		    size == 2 * sizeof(uint64_t)) {
+			region_start = ((uint64_t const *)prop)[0];
+			region_end = ((uint64_t const *)prop)[1];
+		}
+	} else {
+		sweet_early_string("NORD2-XNU: no /chosen\n");
+	}
+	if ((entry == 0 || dtb == 0 || region_start == 0 ||
+	    region_end <= region_start) && nord2_cb_valid) {
+		/*
+		 * arm_vm_init() switched the kernel page tables, so the ADT (placed
+		 * just past the kernel image) is no longer reachable: fall back to
+		 * the copy taken while it still was.
+		 */
+		sweet_early_string("NORD2-XNU: using cached chain-back parameters\n");
+		entry = nord2_cb_entry;
+		dtb = nord2_cb_dtb;
+		region_start = nord2_cb_start;
+		region_end = nord2_cb_end;
+	}
+	if (entry_override != 0) {
+		entry = entry_override;
+	}
+	if (entry == 0 || dtb == 0 || region_start == 0 || region_end <= region_start) {
+		sweet_early_string("NORD2-XNU: cannot chain back\n");
+		for (;;) {
+			__asm__ volatile("wfe");
+		}
+	}
+	sweet_early_string("NORD2-XNU: RETURN TO STOCK ANDROID KERNEL\n");
+	sweet_early_string("NORD2-XNU: entry=");
+	/* Minimal hex, no formatting dependency at this point. */
+	nord2_hex64(entry);
+	sweet_early_string("\n");
+	/*
+	 * The trampoline and its cache-clean loop run through the bootstrap V=P
+	 * map. After the first context switch TTBR0 holds invalid_ttep, so put
+	 * the bootstrap table back. It stays intact for the whole boot: it is
+	 * read-only-late data and cpu.c uses it to start secondary CPUs.
+	 */
+	set_mmu_ttb(kvtophys((vm_offset_t)bootstrap_pagetables) & TTBR_BADDR_MASK);
+	flush_mmu_tlb();
+	/* The trampoline lives 16K above the first mapped block. */
+	nord2_leave_xnu(entry, dtb, region_start, region_end,
+	    region_start + 0x4000);
+}
+
+void
+nord2_return_to_stock(void)
+{
+	nord2_leave_to(0);
+}
+
+/*
+ * Boot-arg nord2stop: 1 (default) stops after cpu_init and returns to the
+ * stock kernel; 0 continues into arm_vm_init (not yet supported on Nord2).
+ */
+/*
+ * Optional later stop points (boot argument nord2stopat=<n>): log a marker and
+ * return to Android with the pmsg log intact. Unlike the arm_vm_init gates
+ * these run with the kernel page tables fully switched, which is fine because
+ * the chain-back parameters were cached at the cpu_init stop.
+ */
+/* kernel_bootstrap_log() / kernel_bootstrap_thread_log() steps (startup.c). */
+void
+nord2_bootstrap_log(const char *who, const char *message)
+{
